{
  "name": "angularjs-easy-components",
  "version": "1.0.0",
  "description": "Componentes modernos e declarativos para AngularJS 1.5+.",
  "main": "src/angularjs-easy-components.js",
  "bin": {
    "easy-components": "bin/easy-components.js"
  },
  "files": [
    "src",
    "bin",
    "lib",
    "ui-kit/components",
    "ui-kit/services",
    "ui-kit/index.js",
    "ui-kit/gcweb.js",
    "ui-kit/README.md",
    "html-custom-data.json",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "SUPPORT.md",
    "LICENSE"
  ],
  "scripts": {
    "components:create": "node bin/easy-components.js create",
    "components:sync": "node bin/easy-components.js sync",
    "components:check": "node bin/easy-components.js check",
    "components:check:legacy": "node scripts/check-legacy-migration.js",
    "legacy:inventory": "node scripts/inventory-legacy-api.js",
    "legacy:parity": "npm run legacy:inventory && node scripts/report-legacy-parity.js",
    "legacy:compatibility:check": "npm run legacy:inventory && node scripts/report-legacy-parity.js --require-complete",
    "test:confirmation": "node test/confirmation-queue.test.js",
    "test:confirmation:browser": "node test/confirmation-browser.test.js",
    "test:migration:native": "node test/native-migration.test.js && node test/table-direct-conversion.test.js",
    "test:table:direct": "node test/table-direct-conversion.test.js",
    "legacy:table:audit": "node scripts/audit-table-conversion.js",
    "prebuild:example": "npm run components:sync",
    "build:example": "node scripts/build-example.js",
    "build:ui": "node scripts/build-ui-kit.js",
    "demo:ui": "npm run build:ui && node scripts/serve-lab.js --ui-kit",
    "test:ui:browser": "node test/confirmation-browser.test.js --ui-kit",
    "build:legacy": "node scripts/build-legacy-migration.js",
    "build:legacy:compat": "node scripts/build-legacy-migration.js --with-legacy-engine",
    "test:migration:browser": "node test/confirmation-browser.test.js --lab",
    "test:migration:22430": "node test/confirmation-browser.test.js --22430",
    "prewatch:example": "npm run components:sync",
    "watch:example": "node scripts/build-example.js --watch",
    "test": "node test/easy-components.test.js",
    "pretest:browser": "npm run build:example",
    "test:browser": "python test/browser_benchmark.py",
    "test:legacy": "python test/legacy_migration_browser.py",
    "validate": "npm test && npm run test:confirmation && npm run test:migration:native && npm run components:check && npm run components:check:legacy && npm run build:example && npm run build:legacy",
    "validate:release": "npm run validate && npm run test:browser && npm run test:legacy && npm run test:migration:browser",
    "pack:check": "npm pack --dry-run",
    "predemo": "npm run build:example",
    "demo": "npx http-server . -o /example/",
    "demo:legacy": "npm run build:legacy && npx http-server . -c-1 -o /legacy-migration/22430.html",
    "demo:lab": "npm run build:legacy && node scripts/serve-lab.js"
  },
  "easyComponents": {
    "componentsDir": "example/components",
    "registry": "example/components/index.generated.js",
    "customData": "html-custom-data.json",
    "build": {
      "entry": "example/app.js",
      "outfile": "example/dist/app.bundle.js",
      "report": "example/dist/easy-components-report.json",
      "target": [
        "es2017"
      ],
      "minify": true,
      "sourcemap": true,
      "budgets": {
        "bundle": 130000,
        "gzip": 30000
      }
    }
  },
  "keywords": [
    "angularjs",
    "component",
    "components",
    "legacy",
    "declarative",
    "frontend"
  ],
  "license": "MIT",
  "browser": "src/angularjs-easy-components.js",
  "exports": {
    ".": "./src/angularjs-easy-components.js",
    "./html-custom-data.json": "./html-custom-data.json",
    "./ui-kit": "./ui-kit/index.js"
  },
  "peerDependencies": {
    "angular": ">=1.5.0 <2"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "acorn": "^8.15.0",
    "bootstrap": "^3.4.1"
  }
}
