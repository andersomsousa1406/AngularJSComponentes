{
  "name": "angularjs-easy-components-navigation",
  "displayName": "AngularJS Easy Components Navigation",
  "description": "Autocomplete, diagnosticos, rename e navegacao para AngularJS Easy Components.",
  "publisher": "local",
  "version": "1.0.0",
  "engines": {
    "vscode": ">=1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "main": "./extension.js",
  "files": [
    "extension.js",
    "navigation.js",
    "semantic.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
    "configuration": {
      "title": "AngularJS Easy Components",
      "properties": {
        "easyComponents.navigation.filePattern": {
          "type": "string",
          "default": "**/*.component.{js,ts,mjs}",
          "description": "Glob usado para localizar declaracoes de componentes."
        }
      }
    }
  }
}
